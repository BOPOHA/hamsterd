#!/bin/bash
# Custom rpkg macros for hamsterd. Referenced by rpkg.conf.

# Generate a dependency archive while building the source RPM. The checkout is
# vendor-free before and after this function runs; mock consumes Source1 without
# requiring network access.
#
# Modules are downloaded into a new private module cache rather than a shared,
# predictable path such as /tmp, where another local user could pre-create
# module trees that `go mod vendor` would trust. `go mod verify` checks the
# extracted modules against go.sum before they are vendored.
function go_vendor_pack {
    local tarball_name="hamsterd-go-vendor.tar.gz"
    local tar_path="${OUTDIR}/${tarball_name%.gz}"
    local vendor_path="$PWD/vendor"
    local module_cache status=0

    echo "go_vendor_pack: resolving modules in $PWD" >&2
    module_cache="$(mktemp -d "${TMPDIR:-/tmp}/hamsterd-gomodcache.XXXXXXXX")" || return 1
    rm -rf -- "$vendor_path"
    {
        GOMODCACHE="$module_cache" GOFLAGS=-modcacherw go mod download &&
            GOMODCACHE="$module_cache" GOFLAGS=-modcacherw go mod verify &&
            GOMODCACHE="$module_cache" GOFLAGS=-modcacherw go mod vendor &&
            # Separate steps: in a pipeline, a tar failure would be hidden
            # behind gzip's successful exit status.
            tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 \
                --numeric-owner -cf "$tar_path" vendor/ &&
            gzip -nf "$tar_path"
    } >&2 || status=1
    rm -rf -- "$vendor_path" "$module_cache"
    if [ "$status" -ne 0 ]; then
        rm -f -- "$tar_path" "${OUTDIR}/${tarball_name}"
        return 1
    fi
    echo "go_vendor_pack: wrote ${OUTDIR}/${tarball_name}" >&2
    echo "$tarball_name"
}
